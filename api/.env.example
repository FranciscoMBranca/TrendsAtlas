# API (Railway: service > Variables). Copy to api/.env only for local runs; never commit real values.

# Exact origins allowed by CORS, comma-separated (the Vercel production domain and any custom domain).
ALLOWED_ORIGINS=http://localhost:3000

# Optional: ONE regex (not a list) for Vercel preview deployments. Single backslashes, no path:
#   ^https://trends-atlas-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# POST requests per minute per client address.
RATE_LIMIT_PER_MIN=60

# Set by Railway automatically; only needed locally.
PORT=8000

# Folder with the real 5° cubes (<variable>.npz). The Docker image sets /app/data/cubes.
TERRATEMPO_CUBES=

