# Web site (Vercel: Project Settings > Environment Variables). Copy to web/.env.local for local runs.
# Not a secret: it is embedded in the browser bundle.

# Public URL of the API on Railway, without a trailing slash.
# Production example: https://<your-service>.up.railway.app
# Without it, production treats the API as unavailable (degraded mode); dev falls back to localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
