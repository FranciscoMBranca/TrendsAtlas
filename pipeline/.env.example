# Pipeline: NASA Earthdata login for `python -m terratempo.ingest` (earthaccess reads these).
# Secrets: keep them in your shell, ~/.netrc or a password manager. Never commit real values.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional: where the cubes are written/read (default: <repo>/data/cubes).
TERRATEMPO_CUBES=
